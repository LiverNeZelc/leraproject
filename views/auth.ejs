<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BookStore — Авторизация</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        /* -------------------- ROOT VARIABLES -------------------- */
        :root {
            --primary: #8B4513;
            --secondary: #D2691E;
            --text: #ffffff;
            --background-blur: rgba(255, 255, 255, 0.15);
            --glass-border: rgba(255, 255, 255, 0.3);
            --input-bg: rgba(255, 255, 255, 0.2);
        }

        /* GLOBAL */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Inter", sans-serif;
        }

        body {
            width: 100%;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            color: var(--text);
            background: url("/images/auth-bg.jpg") center/cover no-repeat fixed; 
            position: relative;
        }

        /* DARK OVERLAY (смягчён для читаемости) */
        body::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5); /* Меньше затемнения */
            z-index: -1;
        }

        /* AUTH CONTAINER */
        .auth-container {
            width: 430px;
            padding: 3rem;
            text-align: center;
            border-radius: 18px;
            background: var(--background-blur);
            border: 1px solid var(--glass-border);
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.45);
            backdrop-filter: blur(14px);
            animation: fadeIn 0.6s ease;
            position: relative;
            z-index: 1; /* Над overlay */
        }

        .auth-title {
            margin-bottom: 1.8rem;
            font-size: 2.4rem;
            font-weight: 700;
            color: white;
            transition: opacity 0.3s ease; /* Плавная смена заголовка */
        }

        /* FORM (с плавным переключением) */
        .auth-form {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            opacity: 0; /* Скрыты по умолчанию */
            max-height: 0;
            overflow: hidden;
            transition: opacity 0.3s ease, max-height 0.3s ease; /* Плавное появление */
        }

        .auth-form.active {
            opacity: 1;
            max-height: 500px; /* Достаточно для формы (адаптируется) */
        }

        /* INPUT */
        .auth-input {
            width: 100%;
            padding: 1rem;
            border-radius: 12px;
            border: 1px solid var(--glass-border);
            background: var(--input-bg);
            color: #fff;
            font-size: 1rem;
            transition: 0.3s ease;
        }

        .auth-input::placeholder {
            color: #e7e7e7;
        }

        .auth-input:focus {
            border-color: var(--secondary);
            outline: none;
            background: rgba(255,255,255,0.25);
            box-shadow: 0 0 0 3px rgba(210, 105, 30, 0.1); /* Акцент на фокус */
        }

        /* BUTTON */
        .auth-btn {
            margin-top: 0.5rem;
            padding: 1rem;
            border: none;
            border-radius: 12px;
            font-size: 1.1rem;
            font-weight: 600;
            color: white;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            cursor: pointer;
            transition: 0.3s;
            box-shadow: 0 8px 25px rgba(210,105,30,0.4);
        }

        .auth-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(210,105,30,0.5);
        }

        .auth-btn:active {
            transform: translateY(-1px);
        }

        /* SWITCH */
        .switch-text {
            margin-top: 1rem;
            font-size: 1rem;
            opacity: 0.85;
        }

        .switch-link {
            font-weight: 700;
            cursor: pointer;
            color: var(--secondary);
            transition: color 0.3s ease;
        }

        .switch-link:hover {
            color: #ffb470; /* Светлее на hover */
        }

        /* ANIMATION */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(25px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* Адаптив: Мобильный дизайн */
        @media (max-width: 480px) {
            .auth-container {
                width: 90%;
                padding: 2rem;
                margin: 1rem;
            }

            .auth-title {
                font-size: 2rem;
            }

            .auth-input, .auth-btn {
                padding: 0.9rem;
                font-size: 16px; /* Предотвращаем зум на iOS */
            }
        }
    </style>
</head>
<body>

    <div class="auth-container">
        <h1 class="auth-title" id="formTitle">Вход</h1>

        <!-- Форма входа -->
        <form id="loginForm" class="auth-form active">
            <input class="auth-input" type="email" name="email" placeholder="Email" required />
            <input class="auth-input" type="password" name="password" placeholder="Пароль" required />
            <button type="submit" class="auth-btn">Войти</button>
            <p class="switch-text">Нет аккаунта?
                <span id="goRegister" class="switch-link">Зарегистрироваться</span>
            </p>
        </form>

        <!-- Форма регистрации -->
        <form id="registerForm" class="auth-form">
            <input class="auth-input" type="text" name="name" placeholder="Имя" required />
            <input class="auth-input" type="email" name="email" placeholder="Email" required />
            <input class="auth-input" type="password" name="password" placeholder="Пароль" required />
            <input class="auth-input" type="password" name="password2" placeholder="Повторите пароль" required />
            <button type="submit" class="auth-btn">Создать аккаунт</button>
            <p class="switch-text">Уже есть аккаунт?
                <span id="goLogin" class="switch-link">Войти</span>
            </p>
        </form>
    </div>


<script src="/js/auth.js"></script>
</body>
</html>