<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BookStore - Книжный магазин</title>
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="../js/main.js"></script>
    <script src="../js/bookstore.js"></script>
    <script src="../js/scroll.js"></script>
    <script src="https://api-maps.yandex.ru/2.1/?lang=ru_RU&apikey=7e87f786-3fa2-4e2d-8b9f-d2c06126150a" type="text/javascript"></script>
    <script src="../js/admin_main.js"></script>
</head>
<body>
    <header>
        <nav>
            <div class="logo">
                <span>📚</span>
                <span>BookStore</span>
            </div>
            <ul class="nav-links">
                <li><a href="#home">Главная</a></li>
                <li class="dropdown">
                    <a href="#categories" class="dropdown-toggle">
                        Категории <i class="fas fa-chevron-down"></i>
                    </a>
                    <ul class="dropdown-menu">
                        <li><a href="#" data-category="all">Все категории</a></li>
                        <li><a href="#" data-category="fiction">Художественная литература</a></li>
                        <li><a href="#" data-category="non-fiction">Нехудожественная литература</a></li>
                        <li><a href="#" data-category="children">Детские книги</a></li>
                        <li><a href="#" data-category="education">Образование</a></li>
                        <li><a href="#" data-category="business">Бизнес</a></li>
                        <li><a href="#" data-category="psychology">Психология</a></li>
                    </ul>
                </li>
                <li><a href="#catalog">Каталог</a></li>
                <li><a href="#reviews">Отзывы</a></li>
                <li><a href="#about">О нас</a></li>
            </ul>
            <div class="header-actions">
                <div class="search-box">
                    <input type="text" id="search-input" placeholder="Поиск книг...">
                    <i class="fas fa-search"></i>
                </div>
                <div class="cart-icon" id="cartIcon">
                    <i class="fas fa-shopping-cart"></i>
                    <span class="cart-count">0</span>
                </div>
                <a class="user-profile-link">
    <div class="user-profile">
        <i class="fas fa-user"></i>
    </div>
</a>
            </div>
        </nav>
    </header>
    <main>
        <section id="home" class="hero">
            <div class="hero-overlay"></div>
            <div class="hero-content">
                <h1>Новинки</h1>
                <p class="hero-slogan">Погрузитесь в увлекательные истории, которые только что появились на полках</p>
                <button class="cta-button" id="goToCatalogBtn">Перейти в каталог</button>
            </div>
        </section>
        <section id="catalog" class="catalog-section">
            <div class="container">
                <h2>Каталог книг</h2>
                <div class="catalog-filters">
                    <select id="category-filter" class="filter-select">
                        <option value="all">Все категории</option>
                        <option value="fiction">Художественная литература</option>
                        <option value="non-fiction">Нехудожественная литература</option>
                        <option value="children">Детские книги</option>
                        <option value="education">Образование</option>
                        <option value="business">Бизнес</option>
                        <option value="psychology">Психология</option>
                    </select>
                    <select id="sort-filter" class="filter-select">
                        <option value="popular">По популярности</option>
                        <option value="price-asc">Цена: по возрастанию</option>
                        <option value="price-desc">Цена: по убыванию</option>
                        <option value="newest">Новинки</option>
                    </select>
                </div>
                <div class="books-grid" id="booksGrid">
                    <!-- Книги будут добавлены через JavaScript -->
                </div>
            </div>
        </section>
        <section id="reviews" class="reviews-section">
            <div class="container">
                <h2>Отзывы читателей</h2>
                <div class="reviews-grid">
                    <div class="review-card">
                        <div class="review-header">
                            <div class="reviewer-info">
                                <i class="fas fa-user-circle"></i>
                                <span>Анна Иванова</span>
                            </div>
                            <div class="review-rating">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                            </div>
                        </div>
                        <p class="review-text">Отличный магазин! Большой выбор книг, быстрая доставка. Рекомендую!</p>
                    </div>
                    <div class="review-card">
                        <div class="review-header">
                            <div class="reviewer-info">
                                <i class="fas fa-user-circle"></i>
                                <span>Дмитрий Петров</span>
                            </div>
                            <div class="review-rating">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="far fa-star"></i>
                            </div>
                        </div>
                        <p class="review-text">Хорошие цены и качественные книги. Буду заказывать еще!</p>
                    </div>
                    <div class="review-card">
                        <div class="review-header">
                            <div class="reviewer-info">
                                <i class="fas fa-user-circle"></i>
                                <span>Мария Сидорова</span>
                            </div>
                            <div class="review-rating">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                            </div>
                        </div>
                        <p class="review-text">Люблю этот магазин! Всегда нахожу что-то интересное для чтения.</p>
                    </div>
                </div>
            </div>
        </section>
        <section id="about" class="about-section">
            <div class="container">
                <h2>О нас</h2>
                <div class="about-content">
                    <div class="about-text">
                        <p>BookStore - это современный книжный магазин с широким ассортиментом литературы на любой вкус. Мы предлагаем книги различных жанров: от классической литературы до современных бестселлеров.</p>
                        <p>Наша миссия - сделать чтение доступным и приятным для каждого. Мы тщательно отбираем книги для нашего каталога, чтобы предложить вам только лучшее.</p>
                    </div>
                    <div class="about-features">
                        <div class="feature-item">
                            <i class="fas fa-shipping-fast"></i>
                            <h4>Быстрая доставка</h4>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-shield-alt"></i>
                            <h4>Гарантия качества</h4>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-percent"></i>
                            <h4>Выгодные цены</h4>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
    <!-- Корзина -->
    <div id="cartModal" class="modal">
        <div class="modal-content cart-modal">
            <span class="close-modal">&times;</span>
            <h2>Корзина</h2>
            <div id="cartItems" class="cart-items">
                <!-- Товары корзины -->
            </div>
            <div class="cart-footer">
                <div class="cart-total">
                    <span>Итого: <strong id="cartTotal">0 BYN</strong></span>
                </div>
                <button class="checkout-btn">Оформить заказ</button>
            </div>
        </div>
    </div>
    <footer>
        <div class="footer-content">
            <div class="footer-section">
                <h4>О магазине</h4>
                <p>BookStore - ваш надежный партнер в мире книг</p>
            </div>
            <div class="footer-section">
                <h4>Контакты</h4>
                <p>Email: info@bookstore.ru</p>
                <p>Телефон: +7 (XXX) XXX-XX-XX</p>
            </div>
            <div class="footer-section">
                <h4>Социальные сети</h4>
                <div class="social-links">
                    <a href="#"><i class="fab fa-facebook"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-telegram"></i></a>
                </div>
            </div>
        </div>
    </footer>
<!-- MODAL ACCOUNT -->
<!-- MODAL ACCOUNT -->
<div id="accountModal" class="modal">
    <div class="modal-content account-modal glass">
        <span class="close-modal">&times;</span>
        <div class="account-header">
            <i class="fas fa-user-circle avatar"></i>
            <h2 id="accName">Имя пользователя</h2>
            <p id="accEmail" class="acc-email">email@example.com</p>
        </div>
        
        <nav class="account-tabs">
            <button id="tabOrders" class="tab-btn active">Текущие заказы</button>
            <button id="tabHistory" class="tab-btn">История заказов</button>
        </nav>
        
        <div class="tab-panes">
            <div id="paneOrders" class="tab-pane active">
                <div id="ordersContainer">
                    <p class="muted">Загрузка текущих заказов...</p>
                </div>
            </div>
            <div id="paneHistory" class="tab-pane">
                <div id="historyContainer">
                    <p class="muted">Загрузка истории заказов...</p>
                </div>
            </div>
        </div>
        
        <button id="logoutBtn" class="logout-btn full">Выйти из аккаунта</button>
    </div>
</div>

<!-- MODAL ADMIN -->
<div id="adminModal" class="modal">
    <div class="modal-content admin-modal glass">
        <span class="close-modal">&times;</span>
        <div class="admin-header">
            <i class="fas fa-user-shield avatar"></i>
            <h2 id="adminName">Имя сотрудника</h2>
            <p id="adminEmail" class="acc-email">email@example.com</p>
        </div>
        <div class="admin-actions">
            <button id="issueModeBtn" class="admin-btn">Режим выдачи</button>
            <button id="deliveryModeBtn" class="admin-btn">Режим доставки</button>
            <button id="adminPanelBtn" class="admin-btn">Админ панель</button>
            <button id="analyticsBtn" class="admin-btn">Получить аналитику</button>
            <button id="adminLogoutBtn" class="logout-btn full">Выход из аккаунта</button>
        </div>
    </div>
</div>

<!-- MODAL ISSUE MODE -->
<div id="issueModeModal" class="modal">
    <div class="modal-content issue-modal glass">
        <span class="close-modal">&times;</span>
        <h2>Режим выдачи</h2>
        <div class="issue-search">
            <input type="text" id="issuePhoneInput" placeholder="Введите номер телефона">
            <button id="issueSearchBtn" class="admin-btn">Найти</button>
        </div>
        <div id="issueOrdersContainer" class="orders-container">
            <!-- Заказы будут добавлены через JavaScript -->
        </div>
    </div>
</div>

<!-- MODAL DELIVERY MODE -->
<div id="deliveryModeModal" class="modal">
    <div class="modal-content delivery-modal glass">
        <span class="close-modal">&times;</span>
        <h2>Режим доставки</h2>
        <div id="deliveryOrdersContainer" class="orders-container">
            <!-- Заказы будут добавлены через JavaScript -->
        </div>
    </div>
</div>

<!-- MODAL MAP -->
<div id="mapModal" class="modal">
    <div class="modal-content map-modal glass">
        <span class="close-modal">&times;</span>
        <h2>Карта доставки</h2>
        <div id="mapContainer" class="map-container">
            <!-- Карта будет загружена через JavaScript -->
        </div>
        <button id="completeDeliveryBtn" class="admin-btn">Заказ доставлен</button>
    </div>
</div>

<!-- MODAL ADMIN PANEL -->
<div id="adminPanelModal" class="modal">
    <div class="modal-content admin-panel-modal glass">
        <span class="close-modal">&times;</span>
        <h2>📚 Админ панель - Добавление книги</h2>
        
        <form id="addBookForm" class="admin-form">
            <div class="form-row">
                <div class="form-group">
                    <label for="bookTitle">📖 Название *</label>
                    <input type="text" id="bookTitle" placeholder="Введите название книги" required>
                </div>
                
                <div class="form-group">
                    <label for="bookAuthor">✍️ Автор *</label>
                    <input type="text" id="bookAuthor" placeholder="Введите имя автора" required>
                </div>
            </div>
            
            <div class="form-row">
                <div class="form-group">
                    <label for="bookPublisher">🏢 Издательство</label>
                    <input type="text" id="bookPublisher" placeholder="Введите издательство">
                </div>
                
                <div class="form-group">
                    <label for="bookGenre">📚 Жанр</label>
                    <select id="bookGenre">
                        <option value="">Выберите жанр</option>
                        <option value="fiction">Художественная литература</option>
                        <option value="non-fiction">Нехудожественная литература</option>
                        <option value="children">Детские книги</option>
                        <option value="education">Образование</option>
                        <option value="business">Бизнес</option>
                        <option value="psychology">Психология</option>
                        <option value="mystery">Детектив</option>
                        <option value="science-fiction">Научная фантастика</option>
                        <option value="fantasy">Фэнтези</option>
                        <option value="romance">Романтика</option>
                        <option value="history">История</option>
                        <option value="biography">Биография</option>
                    </select>
                </div>
            </div>
            
            <div class="form-row">
                <div class="form-group">
                    <label for="bookYear">📅 Год</label>
                    <input type="number" id="bookYear" placeholder="2024" min="1900" max="2100">
                </div>
                
                <div class="form-group">
                    <label for="bookPages">📄 Страниц</label>
                    <input type="number" id="bookPages" placeholder="300" min="1">
                </div>
            </div>
            
            <div class="form-row">
                <div class="form-group">
                    <label for="bookRating">⭐ Рейтинг</label>
                    <input type="number" id="bookRating" placeholder="4.5" min="0" max="5" step="0.1">
                </div }
            </div>
            
            <div class="form-row">
                <div class="form-group">
                    <label for="bookPrice">💰 Цена (BYN) *</label>
                    <input type="number" id="bookPrice" placeholder="29.99" min="0" step="0.01" required>
                </div>
            </div>
            
            <div class="form-group full-width">
                <label for="bookDescription">📝 Описание</label>
                <textarea id="bookDescription" placeholder="Введите описание книги..." rows="5"></textarea>
            </div>
            
            <div class="form-actions">
                <button type="submit" class="btn-submit">➕ Добавить книгу</button>
                <label class="btn-reset" style="cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
                    📁 Загрузить из JSON
                    <input type="file" id="jsonFileInput" accept=".json" style="display: none;">
                </label>
                <button type="button" id="deleteBookBtn" class="btn-delete">🗑️ Удалить по названию</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL ANALYTICS -->
<!-- Модалка аналитики будет создана динамически -->

<!-- Плейсхолдер для модалки заказа (будет заполнен динамически) -->
<div id="orderModalPlaceholder"></div>

</body>
</html>